{
  "name": "claude-tracker",
  "displayName": "Claude Usage Tracker",
  "version": "0.1.0",
  "description": "Reports Claude.ai message counts (per model) and usage limits (per preset) to this workload's own operator. No UI.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node ../../scripts/pack-crx.mjs",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-cloud-tracker/shared": "workspace:*",
    "wxt": "0.21.3"
  },
  "devDependencies": {
    "@types/chrome": "0.0.270",
    "typescript": "5.7.3"
  }
}
